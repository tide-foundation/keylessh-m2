# KeyleSSH DEMO Environment Configuration (committed template)
# Secrets live in .env.demo.local (gitignored).
#
# IMPORTANT — demo is a HYBRID and only the GATEWAY is deployed via this script:
#   Gateway (punchd-gateway ACI):  DEPLOY_ENV=demo ./azure/deploy-devops.sh --gateway
#   Web app (KeyleSSH / demo.keylessh.com): deployed by .github/workflows/azure-deploy.yml
#     and configured via the KeyleSSH web app's TIDECLOAK_CONFIG app setting (env var),
#     NOT by --setup/--webapp here. Do NOT run --setup/--webapp with DEPLOY_ENV=demo.
# See DEPLOYMENT.md.

# ─── Azure Resources ────────────────────────────────────────
RESOURCE_GROUP=KeyleSSH
LOCATION=australiaeast

# ─── Punchd Gateway (ACI) — demo-specific names (no -demo suffix) ──
ACI_NAME=punchd-gateway
DNS_LABEL=punchd-gateway
GATEWAY_IMAGE=tideorg/punchd-gateway:latest
GATEWAY_ID=Tide-GW
GATEWAY_DISPLAY_NAME=Tide Gateway

# ─── Identity (prod login.dauth.me, realm keylessh-demo) ───
SERVER_URL=https://demo.keylessh.com
AUTH_SERVER_PUBLIC_URL=https://login.dauth.me
# TIDECLOAK_CONFIG auto-selects data/tidecloak.demo.json (client keylessh-demo-client).

# ─── Signal Server (shared punchd.keylessh.com) — secrets in .env.demo.local ──
STUN_SERVER_URL=wss://punchd.keylessh.com
API_SECRET=REPLACE_ME
TURN_SECRET=REPLACE_ME
EXTERNAL_IP=20.211.145.216

# ─── Backends (SSH targets for the gateway) ─────────────────
BACKENDS='My Server=ssh://20.5.193.169'
